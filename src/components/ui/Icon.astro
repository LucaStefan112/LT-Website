---
/* Line icons on a 24px grid (1.6 stroke, round joins), drawn in currentColor.
   Decorative: always aria-hidden — the text next to them carries the meaning.
   Content files reference icons by name (e.g. `icon: "search"`). */

interface Props {
  name: string; // a key of `paths` below
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = "" } = Astro.props;

const paths: Record<string, string> = {
  search: `<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>`,
  ranking: `<path d="M9 6h11M9 12h8M9 18h5"/><circle cx="4.5" cy="6" r="1.2"/><circle cx="4.5" cy="12" r="1.2"/><circle cx="4.5" cy="18" r="1.2"/>`,
  presentation: `<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4M8 20h8"/><path d="M7 12.5l3-3 2.5 2 4.5-4.5"/>`,
  code: `<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4.5l-3 15"/>`,
  chart: `<path d="M4 4v16h16"/><path d="M7.5 15l4-4 3 2.5 5-5.5"/><path d="M16 8h3.5v3.5"/>`,
  compass: `<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>`,
  flow: `<rect x="3" y="3" width="6" height="6" rx="1.5"/><rect x="15" y="15" width="6" height="6" rx="1.5"/><path d="M9 6h7a2 2 0 0 1 2 2v7"/>`,
  users: `<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.4 3.3-5.5 6.5-5.5s5.9 2.1 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.4 0 4.2 1.6 4.6 4"/>`,
  target: `<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/>`,
  shield: `<path d="M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>`,
  bolt: `<path d="M13 2.5L4.5 13.5H11l-1 8 8.5-11.5H12z"/>`,
  sparkle: `<path d="M11 3.5l1.9 5.1 5.1 1.9-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9z"/><path d="M18.5 15v5M16 17.5h5"/>`,
  document: `<path d="M6 3h8.5L19 7.5V21H6z"/><path d="M14 3v5h5M9 12.5h6.5M9 16.5h6.5"/>`,
  refresh: `<path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 4v5h-5"/>`,
  sliders: `<path d="M4 7h9M18 7h2M4 17h3M12 17h8"/><circle cx="15.5" cy="7" r="2.3"/><circle cx="9.5" cy="17" r="2.3"/>`,
};
const body = paths[name] ?? "";
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
