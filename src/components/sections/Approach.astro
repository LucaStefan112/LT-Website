---
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Icon from "../ui/Icon.astro";
import { getContent } from "../../content/i18n";
import type { CTA } from "../../content/site";

const { approach, ui } = getContent(Astro.url.pathname);

/* Defaults to the Digitalization Program (`approach`); the /training page
   passes its own step list in the same shape. */
interface Props {
  data?: Pick<typeof approach, "eyebrow" | "title" | "intro" | "outputLabel" | "steps">;
  id?: string;
  variant?: "paper" | "bone";
  more?: CTA; // link under the steps (the home page points to /services)
  compact?: boolean; // hide the "What you get" lines (home page)
}
const { data = approach, id = "approach", variant = "bone", more, compact = false } = Astro.props;
// Five steps sit on one row on wide screens; six wrap as two rows of three.
const colsLg = data.steps.length > 5 ? 3 : data.steps.length;
// On one row, a dashed line joins the icons into a timeline.
const oneRow = colsLg === data.steps.length;
---

<Section id={id} variant={variant} labelledby={`${id}-heading`}>
  <Container>
    <SectionHeader
      eyebrow={data.eyebrow}
      title={data.title}
      intro={data.intro}
      id={`${id}-heading`}
    />

    <ol class:list={["steps", { "steps--row": oneRow }]} role="list" style={`--cols-lg:${colsLg}`}>
      {
        data.steps.map((step, i) => (
          <li class="step reveal" style={`--reveal-delay:${i * 90}ms`}>
            <span class="step-icon">
              <Icon name={step.icon ?? "target"} size={26} />
            </span>
            <span class="step-n" aria-hidden="true">
              {step.n}
            </span>
            <h3 class="step-title">
              <span class="sr-only">{`${ui.stepPrefix} ${i + 1}: `}</span>
              {step.title}
            </h3>
            <p class="step-body">{step.body}</p>
            {!compact && (
              <p class="step-output">
                <span class="step-output-label">{data.outputLabel}</span>
                {step.output}
              </p>
            )}
          </li>
        ))
      }
    </ol>

    {
      more && (
        <a href={more.href} class="link-arrow steps-more">
          {more.label}
          <span class="arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path
                d="M3 8h9M8.5 4l3.5 4-3.5 4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
      )
    }
  </Container>
</Section>

<style>
  .steps-more {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
  }
  .steps {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.75rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    counter-reset: step;
  }
  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem clamp(2rem, 5vw, 3.5rem);
    }
  }
  @media (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .steps {
      --gap: clamp(1.5rem, 2.5vw, 2.25rem);
      grid-template-columns: repeat(var(--cols-lg, 4), 1fr);
      gap: 2.5rem var(--gap);
    }
    /* Timeline: a dashed line from each icon to the next one */
    .steps--row .step:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 27px;
      left: calc(56px + 0.75rem);
      right: calc(-1 * var(--gap) + 0.75rem);
      border-top: 1.5px dashed color-mix(in srgb, var(--color-steel) 45%, transparent);
    }
  }
  .step {
    position: relative;
  }
  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    color: var(--color-steel);
    background-color: color-mix(in srgb, var(--color-steel) 10%, var(--color-paper));
    border: 1px solid color-mix(in srgb, var(--color-steel) 22%, var(--color-paper));
  }
  .step-n {
    display: block;
    margin: 1.25rem 0 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-steel);
    font-variant-numeric: tabular-nums;
  }
  .step-title {
    font-size: 1.25rem; /* 20 */
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-bottom: 0.625rem;
  }
  .step-body {
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .step-output {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .step-output-label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
</style>
