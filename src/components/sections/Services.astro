---
/* The four problem areas in detail (/services): what it looks like from the
   inside, what we do about it, and what you get. Used under the page's <h1>,
   so the section heading is a visually hidden <h2>. */
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import Icon from "../ui/Icon.astro";
import { getContent } from "../../content/i18n";

const { services } = getContent(Astro.url.pathname);

interface Props {
  variant?: "paper" | "bone";
}
const { variant = "bone" } = Astro.props;
---

<Section id="services" variant={variant} labelledby="services-heading">
  <Container>
    <h2 id="services-heading" class="sr-only">{services.eyebrow}</h2>

    <ul class="services-grid" role="list">
      {
        services.items.map((item, i) => (
          <li class="card service reveal" style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <div class="service-head">
              <span class="service-icon">
                <Icon name={item.icon} size={24} />
              </span>
              <h3 class="service-title">{item.title}</h3>
            </div>

            <p class="service-label service-label--problem">{services.symptomsLabel}</p>
            <ul class="service-symptoms" role="list">
              {item.symptoms.map((s) => (
                <li>{s}</li>
              ))}
            </ul>

            <p class="service-label">{services.doLabel}</p>
            <p class="service-body">{item.body}</p>

            <p class="service-label">{services.deliverablesLabel}</p>
            <ul class="service-deliverables" role="list">
              {item.deliverables.map((d) => (
                <li>{d}</li>
              ))}
            </ul>

            {item.link && (
              <a href={item.link.href} class="link-arrow service-link">
                {item.link.label}
                <span class="arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M3 8h9M8.5 4l3.5 4-3.5 4"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <p class="services-toolbox reveal">{services.toolbox}</p>
  </Container>
</Section>

<style>
  /* The band has no visible header (the page <h1> sits right above it),
     so it does not need a full section's worth of top padding. */
  :global(#services.section) {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .services-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  .service {
    display: flex;
    flex-direction: column;
  }
  .service-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .service-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: var(--color-steel);
    background-color: color-mix(in srgb, var(--color-steel) 10%, var(--color-paper));
    border: 1px solid color-mix(in srgb, var(--color-steel) 22%, var(--color-paper));
  }
  .service-title {
    font-size: 1.375rem; /* 22 */
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .service-label {
    margin-top: 1.25rem;
    margin-bottom: 0.6rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .service-head + .service-label {
    margin-top: 0;
  }
  .service-label--problem {
    color: var(--color-ember);
  }
  .service-symptoms,
  .service-deliverables {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .service-symptoms li,
  .service-deliverables li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .service-symptoms li {
    color: var(--color-ink);
  }
  /* Ember dot = a problem, as on the home page and the problem maps */
  .service-symptoms li::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-ember);
  }
  .service-deliverables li {
    color: var(--color-muted);
  }
  .service-deliverables li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.75rem;
    height: 2px;
    background-color: var(--color-steel);
  }
  .service-body {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }
  .service-link {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .services-toolbox {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    max-width: 64ch;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.55;
  }
</style>
