---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { getContent } from "../../content/i18n";

const { hero, site, config } = getContent(Astro.url.pathname);

// Elevate the flat trust line into discrete proof chips.
const proof = hero.trustLine
  .split("·")
  .map((s) => s.trim())
  .filter(Boolean);
---

<section class="hero bg-paper" aria-labelledby="hero-heading">
  <!-- Soft steel wash anchoring the portrait side; decorative only. -->
  <div class="hero-glow" aria-hidden="true"></div>

  <Container>
    <div class="hero-grid">
      <div class="hero-content">
        {/* Eyebrow, rule and the H1 (the LCP element) render at full opacity
            from first paint — they are NOT faded in, so LCP is not deferred.
            Only the supporting content below animates in. */}
        <p class="eyebrow">{hero.eyebrow}</p>
        <span class="rule" aria-hidden="true"></span>

        <h1 id="hero-heading" class="display hero-heading">
          {hero.headline}
        </h1>

        <p class="lead hero-subhead hero-in" style="--d:80ms">
          {hero.subhead}
        </p>

        <div class="hero-actions hero-in" style="--d:180ms">
          <Button
            href={hero.primaryCta.href}
            external={hero.primaryCta.external}
          >
            {hero.primaryCta.label}
          </Button>
          <a href={hero.secondaryCta.href} class="link-arrow hero-secondary">
            {hero.secondaryCta.label}
            <span class="arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M3 8h9M8.5 4l3.5 4-3.5 4"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
        </div>

        <ul class="hero-proof hero-in" style="--d:300ms" aria-label="What sets the practice apart">
          {
            proof.map((item) => (
              <li class="hero-proof-item">
                <span class="hero-proof-dot" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-visual">
        <div class="hero-portrait">
          {/* Ascending chevron — echoes the logo's rising "T"; draws on. */}
          <svg
            class="hero-portrait-motif"
            aria-hidden="true"
            viewBox="0 0 600 600"
            preserveAspectRatio="xMidYMid meet"
          >
            <path
              d="M40 500 L300 90 L560 500"
              fill="none"
              stroke="currentColor"
              stroke-width="14"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>

          {/* Offset panel behind the photo — gives the frame depth. */}
          <span class="hero-portrait-panel" aria-hidden="true"></span>

          {
            config.founderPhoto ? (
              <img
                class="hero-portrait-img"
                src={config.founderPhoto}
                alt={`${site.founder}, founder of ${site.name}`}
                width="800"
                height="800"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <div class="hero-portrait-img hero-portrait-fallback" role="img" aria-label={`${site.founder}, founder of ${site.name}`}>
                <span aria-hidden="true">LT</span>
              </div>
            )
          }

          <figcaption class="hero-portrait-tag hero-in" style="--d:360ms">
            <span class="hero-tag-name">{site.founder}</span>
            <span class="hero-tag-role">{hero.tagRole} · {site.shortName}</span>
          </figcaption>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(5.5rem, 10vw, 8.5rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  /* Subtle depth so the section no longer reads as a flat white slab. */
  .hero-glow {
    position: absolute;
    top: -18%;
    right: -12%;
    width: min(60vw, 780px);
    aspect-ratio: 1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-steel) 12%, transparent),
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.75rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.82fr);
      gap: clamp(2.5rem, 5vw, 5.5rem);
    }
  }

  .hero-content {
    max-width: 36rem;
  }

  .hero-heading {
    margin-top: 1.35rem;
  }
  .hero-subhead {
    margin-top: 1.35rem;
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.1rem;
  }
  .hero-secondary {
    min-height: 2.875rem;
    padding-block: 0.5rem;
  }

  /* Proof chips — replaces the faint single-line trust text. */
  .hero-proof {
    list-style: none;
    margin: 2.1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.75rem;
  }
  .hero-proof-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-steel) 4%, var(--color-paper));
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .hero-proof-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-steel);
    flex: none;
  }

  /* -------------------------------------------------------- Portrait side */
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .hero-visual {
      justify-content: flex-end;
    }
  }

  .hero-portrait {
    position: relative;
    width: min(100%, 22.5rem);
    aspect-ratio: 4 / 5;
  }

  .hero-portrait-motif {
    position: absolute;
    top: -22%;
    left: 50%;
    transform: translateX(-50%);
    width: 132%;
    max-width: none; /* opt out of the global svg{max-width:100%} clamp */
    height: auto;
    color: var(--color-steel);
    opacity: 0.16;
    z-index: 0;
    pointer-events: none;
  }

  .hero-portrait-panel {
    position: absolute;
    inset: 0;
    transform: translate(1.15rem, 1.15rem);
    border-radius: 18px;
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-steel) 16%, var(--color-bone)),
      color-mix(in srgb, var(--color-steel) 5%, var(--color-bone))
    );
    z-index: 0;
  }

  .hero-portrait-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--color-steel) 28%, var(--color-line));
    box-shadow: 0 26px 60px -30px color-mix(in srgb, var(--color-ink) 55%, transparent);
    background-color: var(--color-bone);
  }
  .hero-portrait-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 3rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--color-ink) 40%, transparent);
  }

  /* Floating name tag — tells visitors who they're looking at. */
  .hero-portrait-tag {
    position: absolute;
    z-index: 2;
    left: -0.75rem;
    bottom: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.95rem;
    background-color: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 11px;
    box-shadow: 0 14px 30px -16px color-mix(in srgb, var(--color-ink) 45%, transparent);
  }
  .hero-tag-name {
    font-weight: 650;
    font-size: 0.9375rem;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .hero-tag-role {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .hero-portrait {
      width: min(100%, 17.5rem);
    }
    .hero-portrait-tag {
      left: 0;
    }
  }

  /* Orchestrated entrance — runs once on load, JS + motion-safe only.
     The H1 and the portrait IMAGE are deliberately excluded so LCP paints
     immediately; only supporting/decorative layers animate in. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-in {
      opacity: 0;
      transform: translateY(18px);
      animation: heroIn 0.7s var(--ease-out-soft) forwards;
      animation-delay: var(--d, 0ms);
    }
    :global(html.js) .hero-portrait-panel {
      opacity: 0;
      transform: translate(1.15rem, 1.15rem) scale(0.965);
      animation: heroPanelIn 0.8s var(--ease-out-soft) 0.12s forwards;
    }
    :global(html.js) .hero-portrait-motif path {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      animation: heroDraw 1.1s var(--ease-out-soft) 0.2s forwards;
    }
  }
  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes heroPanelIn {
    to {
      opacity: 1;
      transform: translate(1.15rem, 1.15rem) scale(1);
    }
  }
  @keyframes heroDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
