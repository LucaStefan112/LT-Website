---
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import RekeyIllustration from "../illustrations/RekeyIllustration.astro";
import { getContent } from "../../content/i18n";

const { intro } = getContent(Astro.url.pathname);
---

<Section variant="bone" tight labelledby="intro-heading">
  <Container>
    <div class="intro-grid">
      <div class="intro-text reveal">
        <h2 id="intro-heading" class="eyebrow">{intro.eyebrow}</h2>
        <span class="rule" aria-hidden="true"></span>
        <p class="intro-copy">{intro.body}</p>
      </div>
      <div class="intro-visual reveal" style="--reveal-delay:120ms">
        <RekeyIllustration />
      </div>
    </div>
  </Container>
</Section>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 5rem);
    }
  }
  .intro-copy {
    margin-top: 1.5rem;
    color: var(--color-ink);
    font-size: clamp(1.25rem, 2.2vw, 1.625rem); /* 20 → 26 */
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 36ch;
    text-wrap: pretty;
  }
  .intro-visual {
    max-width: 34rem;
    width: 100%;
    justify-self: center;
  }
</style>
