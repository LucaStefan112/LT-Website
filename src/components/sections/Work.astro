---
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import WorkCard from "../work/WorkCard.astro";
import { getContent, resolveLocale, localePath } from "../../content/i18n";

const { work, ui } = getContent(Astro.url.pathname);
const locale = resolveLocale(Astro.url.pathname);

// The home page shows a selection, in this order; /work lists every project.
const featured = work.homeSlugs.map((slug) => work.projects.find((p) => p.slug === slug)!);
---

<Section id="work" variant="paper" labelledby="work-heading">
  <Container>
    <SectionHeader
      eyebrow={work.eyebrow}
      intro={work.intro}
      id="work-heading"
    />

    <ul class="work-grid" role="list">
      {
        featured.map((p, i) => (
          <li class="reveal" style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <WorkCard project={p} />
          </li>
        ))
      }
    </ul>

    <a href={localePath(locale, "/work")} class="link-arrow work-all">
      {ui.allWork} ({work.projects.length})
      <span class="arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h9M8.5 4l3.5 4-3.5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </a>
  </Container>
</Section>

<style>
  .work-grid {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.75rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  .work-all {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
    display: inline-flex;
    font-weight: 600;
  }
</style>
