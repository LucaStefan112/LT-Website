---
import Section from "../ui/Section.astro";
import Container from "../ui/Container.astro";
import Reveal from "../ui/Reveal.astro";
import { getContent } from "../../content/i18n";

const { layers } = getContent(Astro.url.pathname);
---

<Section variant="paper" tight labelledby="layers-heading">
  <Container>
    <div class="layers-grid">
      <Reveal class="layers-copy">
        <h2 id="layers-heading" class="eyebrow">{layers.eyebrow}</h2>
        <span class="rule" aria-hidden="true"></span>
        <p class="layers-body">{layers.body}</p>
      </Reveal>

      <Reveal delay={90}>
        <ul role="list" class="levels">
          {
            layers.items.map((level, i) => (
              <li class="level">
                <span class="level-rule" aria-hidden="true" />
                <p class="level-layer">
                  <span aria-hidden="true">0{i + 1}</span>
                  {level.layer}
                </p>
                <h3 class="level-question">{level.question}</h3>
                <p class="level-detail">{level.detail}</p>
              </li>
            ))
          }
        </ul>
      </Reveal>
    </div>
  </Container>
</Section>

<style>
  .layers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 900px) {
    .layers-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .layers-body {
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  .levels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .level {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .level-rule {
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background-color: var(--color-steel);
  }
  .level-layer {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .level-question {
    font-size: 1.375rem; /* 22 */
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }
  .level-detail {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 42ch;
  }
</style>
