---
/* Architecture diagram for the self-hosted Restaurant Menu Assistant.
   Reflects the real stack; styled with the page accent (var(--accent)).
   NOTE: the visible node labels below are still hardcoded English. They are
   stack names plus two prose lines; localise them via `ui` if the Romanian
   work page needs them translated. */
import { getContent } from "../../content/i18n";

const { ui } = getContent(Astro.url.pathname);
---

<div class="rag" role="img" aria-label={ui.ragDiagramAlt}>
  <span class="rag-boundary-label">{ui.ragDiagram.boundary}</span>

  <div class="rag-row">
    <div class="rag-node">{ui.ragDiagram.customerChat}<span>{ui.ragDiagram.customerChatSub}</span></div>
    <div class="rag-node">{ui.ragDiagram.adminPanel}<span>{ui.ragDiagram.adminPanelSub}</span></div>
  </div>

  <div class="rag-link" aria-hidden="true"></div>

  <div class="rag-row">
    <div class="rag-node rag-node--accent">Python API<span>{ui.ragDiagram.apiSub}</span></div>
  </div>

  <div class="rag-link" aria-hidden="true"></div>

  <div class="rag-row rag-row--services">
    <div class="rag-node">Ollama<span>qwen2.5:3b · bge-m3</span></div>
    <div class="rag-node">Qdrant<span>{ui.ragDiagram.qdrantSub}</span></div>
    <div class="rag-node">PostgreSQL<span>{ui.ragDiagram.postgresSub}</span></div>
    <div class="rag-node">MinIO<span>{ui.ragDiagram.minioSub}</span></div>
  </div>
</div>

<style>
  .rag {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background-color: color-mix(in srgb, var(--accent) 5%, var(--color-paper));
  }
  .rag-boundary-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .rag-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
  }
  .rag-node {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 auto;
    min-width: 8.5rem;
    max-width: 15rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.9375rem;
    text-align: center;
  }
  .rag-node span {
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .rag-node--accent {
    border-color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 10%, var(--color-paper));
    max-width: 22rem;
  }
  .rag-link {
    width: 2px;
    height: 1.75rem;
    background-color: color-mix(in srgb, var(--accent) 55%, var(--color-line));
    margin: 0.25rem 0;
  }
</style>
