---
/* The written diagnosis: a short report plus the "what it costs × how hard
   it is to fix" map, with the one item to fix first ringed. Text-free. */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class:list={["diag-ill", className]}
  viewBox="0 0 400 200"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id="diag-shadow" x="-15%" y="-15%" width="130%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="9" flood-color="#16304c" flood-opacity="0.13" />
    </filter>
  </defs>

  <!-- Report: back page + front page with a folded corner -->
  <rect x="58" y="30" width="118" height="150" rx="8" class="dg-page dg-page--back" transform="rotate(-6 117 105)" />
  <g filter="url(#diag-shadow)">
    <path d="M70 22h82l24 24v136a6 6 0 0 1-6 6H70a6 6 0 0 1-6-6V28a6 6 0 0 1 6-6z" class="dg-page" />
  </g>
  <path d="M152 22v18a6 6 0 0 0 6 6h18" class="dg-fold" />
  <rect x="78" y="38" width="56" height="9" rx="4.5" class="dg-title" />
  <rect x="78" y="58" width="82" height="6" rx="3" class="dg-line" />
  <rect x="78" y="71" width="70" height="6" rx="3" class="dg-line" />
  <rect x="78" y="84" width="78" height="6" rx="3" class="dg-line" />
  <rect x="78" y="104" width="84" height="30" rx="6" class="dg-callout" />
  <path d="M88 119l5 5 9-10" class="dg-check" />
  <rect x="110" y="114" width="42" height="6" rx="3" class="dg-callout-line" />
  <rect x="78" y="146" width="80" height="6" rx="3" class="dg-line" />
  <rect x="78" y="159" width="62" height="6" rx="3" class="dg-line" />

  <!-- Cost × effort map -->
  <g filter="url(#diag-shadow)">
    <rect x="206" y="28" width="170" height="150" rx="10" class="dg-map" />
  </g>
  <path d="M226 46v112h134" class="dg-axis" />
  <path d="M293 50v104M230 102h126" class="dg-quad" />
  <circle cx="320" cy="76" r="20" class="dg-ring" />
  <circle cx="320" cy="76" r="9" class="dg-dot dg-dot--key" />
  <circle cx="262" cy="70" r="6" class="dg-dot" />
  <circle cx="338" cy="128" r="7" class="dg-dot dg-dot--muted" />
  <circle cx="254" cy="132" r="5" class="dg-dot dg-dot--muted" />
  <circle cx="276" cy="116" r="6.5" class="dg-dot" />
</svg>

<style>
  .diag-ill {
    display: block;
    width: 100%;
    height: auto;
  }
  .dg-page {
    fill: var(--color-paper);
    stroke: var(--color-line);
  }
  .dg-page--back {
    fill: color-mix(in srgb, var(--color-steel) 8%, var(--color-paper));
  }
  .dg-fold {
    fill: color-mix(in srgb, var(--color-ink) 6%, var(--color-paper));
    stroke: var(--color-line);
  }
  .dg-title {
    fill: var(--color-ink);
  }
  .dg-line {
    fill: color-mix(in srgb, var(--color-ink) 10%, var(--color-paper));
  }
  .dg-callout {
    fill: color-mix(in srgb, var(--color-steel) 12%, var(--color-paper));
    stroke: color-mix(in srgb, var(--color-steel) 40%, var(--color-paper));
  }
  .dg-callout-line {
    fill: color-mix(in srgb, var(--color-steel) 45%, var(--color-paper));
  }
  .dg-check {
    fill: none;
    stroke: var(--color-steel);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dg-map {
    fill: var(--color-paper);
    stroke: var(--color-line);
  }
  .dg-axis {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .dg-quad {
    fill: none;
    stroke: var(--color-line);
    stroke-dasharray: 3 4;
  }
  .dg-ring {
    fill: color-mix(in srgb, var(--color-steel) 12%, transparent);
    stroke: var(--color-steel);
    stroke-width: 1.4;
    stroke-dasharray: 3 3;
  }
  .dg-dot {
    fill: var(--color-steel-bright);
  }
  .dg-dot--key {
    fill: var(--color-steel);
  }
  .dg-dot--muted {
    fill: color-mix(in srgb, var(--color-ink) 22%, var(--color-paper));
  }
</style>
