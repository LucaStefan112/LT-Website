---
/* "The same numbers re-keyed into three systems": one order (#1048) copied
   by hand from an email into a spreadsheet and again into the ERP.
   Text-free apart from tool names and the order itself, so it needs no
   translation. Decorative; the paragraph beside it says the same thing. */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class:list={["rekey", className]}
  viewBox="0 0 520 400"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <filter id="rekey-shadow" x="-10%" y="-10%" width="120%" height="130%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#16304c" flood-opacity="0.12" />
    </filter>
    <marker id="rekey-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M1 1l7 4-7 4" class="rk-arrowhead" />
    </marker>
  </defs>

  <!-- 1 · Email -->
  <g filter="url(#rekey-shadow)">
    <rect x="16" y="24" width="232" height="132" rx="12" class="rk-window" />
  </g>
  <path d="M16 36a12 12 0 0 1 12-12h208a12 12 0 0 1 12 12v12H16z" class="rk-bar" />
  <circle cx="34" cy="36" r="3.5" class="rk-dot" /><circle cx="46" cy="36" r="3.5" class="rk-dot" /><circle cx="58" cy="36" r="3.5" class="rk-dot" />
  <text x="232" y="40" text-anchor="end" class="rk-title">Email</text>
  <rect x="34" y="64" width="120" height="7" rx="3.5" class="rk-line" />
  <rect x="34" y="114" width="176" height="7" rx="3.5" class="rk-line" />
  <rect x="34" y="132" width="132" height="7" rx="3.5" class="rk-line" />
  <rect x="34" y="82" width="148" height="22" rx="6" class="rk-pill" />
  <text x="44" y="97" class="rk-value">#1048 · 3 875</text>

  <!-- 2 · Spreadsheet -->
  <g filter="url(#rekey-shadow)">
    <rect x="146" y="132" width="256" height="150" rx="12" class="rk-window" />
  </g>
  <path d="M146 144a12 12 0 0 1 12-12h232a12 12 0 0 1 12 12v12H146z" class="rk-bar" />
  <circle cx="164" cy="144" r="3.5" class="rk-dot" /><circle cx="176" cy="144" r="3.5" class="rk-dot" /><circle cx="188" cy="144" r="3.5" class="rk-dot" />
  <text x="386" y="148" text-anchor="end" class="rk-title">Excel</text>
  <g class="rk-grid">
    <path d="M162 174h224M162 196h224M162 218h224M162 240h224M162 262h224" />
    <path d="M232 168v100M300 168v100" />
  </g>
  <rect x="172" y="180" width="44" height="8" rx="4" class="rk-line" />
  <rect x="242" y="180" width="40" height="8" rx="4" class="rk-line" />
  <rect x="310" y="180" width="54" height="8" rx="4" class="rk-line" />
  <rect x="164" y="198" width="220" height="18" rx="4" class="rk-pill" />
  <text x="172" y="211" class="rk-value">#1048</text>
  <text x="310" y="211" class="rk-value">3 875</text>
  <rect x="172" y="224" width="40" height="8" rx="4" class="rk-line" />
  <rect x="242" y="224" width="44" height="8" rx="4" class="rk-line" />
  <rect x="310" y="224" width="48" height="8" rx="4" class="rk-line" />
  <rect x="172" y="246" width="44" height="8" rx="4" class="rk-line" />
  <rect x="242" y="246" width="36" height="8" rx="4" class="rk-line" />
  <rect x="310" y="246" width="52" height="8" rx="4" class="rk-line" />

  <!-- 3 · ERP form -->
  <g filter="url(#rekey-shadow)">
    <rect x="272" y="244" width="232" height="140" rx="12" class="rk-window" />
  </g>
  <path d="M272 256a12 12 0 0 1 12-12h208a12 12 0 0 1 12 12v12H272z" class="rk-bar" />
  <circle cx="290" cy="256" r="3.5" class="rk-dot" /><circle cx="302" cy="256" r="3.5" class="rk-dot" /><circle cx="314" cy="256" r="3.5" class="rk-dot" />
  <text x="488" y="260" text-anchor="end" class="rk-title">ERP</text>
  <rect x="290" y="282" width="56" height="7" rx="3.5" class="rk-line" />
  <rect x="290" y="294" width="196" height="24" rx="6" class="rk-input" />
  <text x="300" y="311" class="rk-value">#1048</text>
  <rect x="290" y="328" width="44" height="7" rx="3.5" class="rk-line" />
  <rect x="290" y="340" width="196" height="24" rx="6" class="rk-input" />
  <text x="300" y="357" class="rk-value">3 875</text>
  <rect x="352" y="343" width="1.6" height="18" class="rk-caret" />

  <!-- Manual copy → paste, twice -->
  <path d="M190 93 C 300 88, 462 110, 404 190" class="rk-flow" marker-end="url(#rekey-arrow)" />
  <path d="M160 222 C 104 262, 150 304, 284 306" class="rk-flow" marker-end="url(#rekey-arrow)" />

  <g transform="translate(424 118)">
    <rect width="66" height="26" rx="7" class="rk-key" />
    <text x="33" y="17.5" text-anchor="middle" class="rk-keytext">Ctrl C</text>
  </g>
  <g transform="translate(40 268)">
    <rect width="66" height="26" rx="7" class="rk-key" />
    <text x="33" y="17.5" text-anchor="middle" class="rk-keytext">Ctrl V</text>
  </g>

  <!-- Cursor on the second paste -->
  <path d="M452 352l0 22 6-5.5 4 9 4-1.8-4-8.8 8-.4z" class="rk-cursor" />
</svg>

<style>
  .rekey {
    display: block;
    width: 100%;
    height: auto;
    font-family: inherit;
  }
  .rk-window {
    fill: var(--color-paper);
    stroke: var(--color-line);
  }
  .rk-bar {
    fill: color-mix(in srgb, var(--color-ink) 6%, var(--color-paper));
  }
  .rk-dot {
    fill: color-mix(in srgb, var(--color-ink) 18%, var(--color-paper));
  }
  .rk-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-muted);
  }
  .rk-line {
    fill: color-mix(in srgb, var(--color-ink) 9%, var(--color-paper));
  }
  .rk-grid {
    stroke: var(--color-line);
    stroke-width: 1;
    fill: none;
  }
  .rk-pill {
    fill: color-mix(in srgb, var(--color-steel) 14%, var(--color-paper));
    stroke: color-mix(in srgb, var(--color-steel) 45%, var(--color-paper));
  }
  .rk-input {
    fill: var(--color-paper);
    stroke: color-mix(in srgb, var(--color-steel) 55%, var(--color-paper));
    stroke-width: 1.4;
  }
  .rk-value {
    font-size: 12.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    fill: var(--color-ink);
  }
  .rk-caret {
    fill: var(--color-steel);
  }
  .rk-flow {
    fill: none;
    stroke: var(--color-steel);
    stroke-width: 1.8;
    stroke-dasharray: 5 6;
    stroke-linecap: round;
  }
  .rk-arrowhead {
    fill: none;
    stroke: var(--color-steel);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rk-key {
    fill: var(--color-ink);
  }
  .rk-keytext {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: #fff;
  }
  .rk-cursor {
    fill: var(--color-ink);
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rk-flow {
      animation: rk-dash 1.6s linear infinite;
    }
    .rk-caret {
      animation: rk-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes rk-dash {
    to {
      stroke-dashoffset: -22;
    }
  }
  @keyframes rk-blink {
    50% {
      opacity: 0;
    }
  }
</style>
