---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Reveal from "../components/ui/Reveal.astro";
import PageIntro from "../components/sections/PageIntro.astro";
import Approach from "../components/sections/Approach.astro";
import CTABand from "../components/sections/CTABand.astro";
import Icon from "../components/ui/Icon.astro";
import TrainingIllustration from "../components/illustrations/TrainingIllustration.astro";
import { getContent, resolveLocale, localePath } from "../content/i18n";

/* /training — training & enablement as one stage of digitalization, not a
   course catalogue. Sections: why → who → formats → how → who teaches it
   (technical credibility) → where it leads (the bridge to implementation). */
const { pageMeta, trainingPage: tp, site, work } = getContent(Astro.url.pathname);
const meta = pageMeta.training;
const locale = resolveLocale(Astro.url.pathname);

// "Who teaches it" tiles: the real builds behind each kind of training.
const workImages = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.png", { eager: true });
const tiles = tp.credibility.tiles.map((tile) => {
  const project = work.projects.find((p) => p.slug === tile.slug)!;
  const image = project.image ? workImages[`../assets/work/${project.image}.png`]?.default : undefined;
  return { ...tile, project, image };
});
---

<Base title={meta.title} description={meta.description} path={meta.path}>
  <PageIntro
    eyebrow={tp.eyebrow}
    title={tp.heading}
    lead={tp.lead}
    headingId="training-page-heading"
  >
    <Button href={site.primaryCta.href} external={site.primaryCta.external}>
      {site.primaryCta.label}
    </Button>
    <a href={tp.heroSecondary.href} class="link-arrow">
      {tp.heroSecondary.label}
      <span class="arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path
            d="M3 8h9M8.5 4l3.5 4-3.5 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
    <TrainingIllustration slot="visual" />
  </PageIntro>

  {/* Why: the business case for training, as outcomes */}
  <Section variant="bone" labelledby="tr-why-heading">
    <Container>
      <div class="tr-why">
        <Reveal>
          <SectionHeader
            eyebrow={tp.why.eyebrow}
            title={tp.why.heading}
            intro={tp.why.body}
            id="tr-why-heading"
          />
        </Reveal>
        <Reveal delay={90}>
          <div class="tr-outcomes">
            <p class="tr-label">{tp.why.outcomesLabel}</p>
            <ul class="tr-list" role="list">
              {tp.why.outcomes.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        </Reveal>
      </div>
    </Container>
  </Section>

  {/* Who it's for */}
  <Section variant="paper" labelledby="tr-who-heading">
    <Container>
      <SectionHeader eyebrow={tp.audience.eyebrow} title={tp.audience.heading} id="tr-who-heading" />
      <ul class="tr-audience" role="list">
        {
          tp.audience.items.map((a, i) => (
            <li class="tr-audience-item reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
              <span class="tr-rule" aria-hidden="true" />
              <h3 class="tr-item-title">{a.title}</h3>
              <p class="tr-item-body">{a.body}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  {/* Example formats */}
  <Section variant="bone" labelledby="tr-formats-heading">
    <Container>
      <SectionHeader
        eyebrow={tp.formats.eyebrow}
        title={tp.formats.heading}
        intro={tp.formats.intro}
        id="tr-formats-heading"
      />
      <ul class="tr-formats" role="list">
        {
          tp.formats.items.map((f, i) => (
            <li class="card tr-format reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
              <span class="tr-format-icon">
                <Icon name={f.icon ?? "target"} size={24} />
              </span>
              <h3 class="card-title">{f.title}</h3>
              <p class="tr-item-body">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  {/* How it works — same component as the Digitalization Program */}
  <Approach data={tp.process} id="how" variant="paper" />

  {/* Who teaches it: technical credibility, tied to real builds */}
  <section class="tr-cred band-ink on-dark" aria-labelledby="tr-cred-heading">
    <Container>
      <div class="tr-cred-grid">
        <Reveal>
          <p class="eyebrow">{tp.credibility.eyebrow}</p>
          <span class="rule" aria-hidden="true"></span>
          <h2 id="tr-cred-heading" class="section-title tr-cred-title">
            {tp.credibility.heading}
          </h2>
        </Reveal>
        <Reveal delay={90}>
          <p class="lead tr-cred-body">{tp.credibility.body}</p>
        </Reveal>
      </div>

      <ul class="tr-tiles" role="list">
        {
          tiles.map((tile, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 90}ms`}>
              <a href={localePath(locale, `/work/${tile.slug}`)} class="tr-tile" style={`--accent:${tile.project.accent}`}>
                <div class="tr-tile-media">
                  {tile.image ? (
                    <Image src={tile.image} alt="" widths={[400, 720]} sizes="(min-width: 960px) 30vw, 92vw" loading="lazy" />
                  ) : (
                    <div class="tr-tile-arch" aria-hidden="true">
                      <span class="tr-arch-node">Chat</span>
                      <span class="tr-arch-link" />
                      <span class="tr-arch-node tr-arch-node--accent">Python API</span>
                      <span class="tr-arch-link" />
                      <span class="tr-arch-row">
                        <span class="tr-arch-node">Ollama</span>
                        <span class="tr-arch-node">Qdrant</span>
                        <span class="tr-arch-node">PostgreSQL</span>
                      </span>
                    </div>
                  )}
                </div>
                <p class="tr-tile-name">{tile.project.name}</p>
                <p class="tr-tile-caption">{tile.caption}</p>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="tr-cred-foot reveal">
        <p class="tr-cred-note">{tp.credibility.note}</p>
        <a href={tp.credibility.link.href} class="link-arrow tr-cred-link">
          {tp.credibility.link.label}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </section>

  {/* Where it leads: training as one stage, implementation optional */}
  <Section variant="paper" tight labelledby="tr-bridge-heading">
    <Container>
      <Reveal>
        <div class="tr-bridge">
          <SectionHeader
            eyebrow={tp.bridge.eyebrow}
            title={tp.bridge.heading}
            intro={tp.bridge.body}
            id="tr-bridge-heading"
          />
          <ul class="tr-bridge-links" role="list">
            {
              tp.bridge.links.map((l) => (
                <li>
                  <a href={l.href} class="link-arrow">
                    {l.label}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </Reveal>
    </Container>
  </Section>

  <CTABand heading={tp.ctaHeading} secondary={tp.heroSecondary} />
</Base>

<style>
  .tr-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
    margin-bottom: 1.25rem;
  }

  /* Why */
  .tr-why {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 960px) {
    .tr-why {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .tr-outcomes {
    background-color: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .tr-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .tr-list li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .tr-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 1rem;
    height: 2px;
    background-color: var(--color-steel);
  }

  /* Who it's for */
  .tr-audience {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 640px) {
    .tr-audience {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .tr-audience {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .tr-audience-item {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .tr-rule {
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background-color: var(--color-steel);
  }
  .tr-item-title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }
  .tr-item-body {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* Formats */
  .tr-formats {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .tr-formats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .tr-formats {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
  .tr-format .card-title {
    margin-bottom: 0.6rem;
  }

  /* Who teaches it */
  .tr-cred {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .tr-cred-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 clamp(2.5rem, 5vw, 4rem);
    align-items: end;
  }
  @media (min-width: 960px) {
    .tr-cred-grid {
      grid-template-columns: 1fr 1fr;
    }
    .tr-cred-grid .tr-cred-body {
      margin-top: 0;
    }
  }
  .tr-cred-title {
    margin-top: 1.25rem;
    color: #fff;
    max-width: 20ch;
  }
  .tr-cred-body {
    margin-top: 1.25rem;
    max-width: 48ch;
  }
  .tr-cred-link {
    font-weight: 600;
    flex: none;
  }

  /* Real builds as image tiles */
  .tr-tiles {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .tr-tiles {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
  .tr-tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.75rem 0.75rem 1.25rem;
    border-radius: 16px;
    border: 1px solid var(--color-line-dark);
    background-color: color-mix(in srgb, #fff 4%, transparent);
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease-out-soft),
      transform 0.3s var(--ease-out-soft);
  }
  .tr-tile:hover {
    border-color: var(--color-steel-bright);
    transform: translateY(-3px);
  }
  .tr-tile-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 10px;
    background-color: var(--color-paper);
  }
  .tr-tile-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .tr-tile-name {
    margin: 1rem 0.5rem 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #fff;
  }
  .tr-tile-caption {
    margin: 0.4rem 0.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-bone) 78%, transparent);
  }
  /* Mini architecture for the build that has no screenshot */
  .tr-tile-arch {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 1rem;
    background-color: color-mix(in srgb, var(--accent) 7%, var(--color-paper));
  }
  .tr-arch-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }
  .tr-arch-node {
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--color-line));
    background-color: var(--color-paper);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .tr-arch-node--accent {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .tr-arch-link {
    width: 2px;
    height: 14px;
    background-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .tr-cred-foot {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-dark);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .tr-cred-note {
    margin: 0;
    max-width: 60ch;
    color: color-mix(in srgb, var(--color-bone) 82%, transparent);
    font-size: 1rem;
  }

  /* Format cards */
  .tr-format-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1.1rem;
    border-radius: 12px;
    color: var(--color-steel);
    background-color: color-mix(in srgb, var(--color-steel) 10%, var(--color-paper));
  }

  /* Where it leads */
  .tr-bridge-links {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.25rem;
  }
  .tr-bridge-links .link-arrow {
    font-weight: 600;
  }
</style>
