---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Container from "../components/ui/Container.astro";
import CTABand from "../components/sections/CTABand.astro";
import FounderPhoto from "../components/ui/FounderPhoto.astro";
import Partners from "../components/sections/Partners.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import { getContent, resolveLocale, localePath } from "../content/i18n";

const locale = resolveLocale(Astro.url.pathname);
const { pageMeta, aboutPage, site, work } = getContent(Astro.url.pathname);
const workImages = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.png", { eager: true });
const builds = aboutPage.workSlugs
  .map((slug) => work.projects.find((p) => p.slug === slug)!)
  .map((p) => ({ ...p, img: p.image ? workImages[`../assets/work/${p.image}.png`]?.default : undefined }));
const meta = pageMeta.about;
const links = [
  { label: locale === "ro" ? "LinkedIn — companie" : "Company LinkedIn", href: site.links.companyLinkedin },
  { label: locale === "ro" ? "Luca pe LinkedIn" : "Luca on LinkedIn", href: site.links.founderLinkedin },
  { label: "GitHub", href: site.links.github },
];
---

<Base title={meta.title} description={meta.description} path={meta.path}>
  <section class="about-hero bg-paper" aria-labelledby="about-heading">
    <Container>
      <div class="about-hero-grid">
        <div class="about-hero-copy">
          <p class="eyebrow">{aboutPage.eyebrow}</p>
          <span class="rule" aria-hidden="true"></span>
          <h1 id="about-heading" class="display-lg about-hero-title">
            {/* One sentence per line, so a short word never dangles at a line end */}
            {aboutPage.heading.split(/(?<=\.)\s+/).map((line, i) => (
              <Fragment>
                {i > 0 && " "}
                <span class="about-hero-line">{line}</span>
              </Fragment>
            ))}
          </h1>
          <p class="lead about-hero-lead">{aboutPage.lead}</p>
        </div>
        <FounderPhoto caption={aboutPage.photoCaption} class="about-hero-photo" />
      </div>
    </Container>
  </section>

  <!-- The practitioner's story, in the first person -->
  <section class="about-story bg-paper">
    <Container>
      <div class="about-body-inner measure-wide">
        <div class="prose about-story-prose">
          {aboutPage.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </Container>
  </section>

  <!-- How I think: the working rules, which replace the old "beliefs" and
       "how we like to work" blocks -->
  <section class="about-principles bg-bone" aria-labelledby="principles-heading">
    <Container>
      <div class="principles-grid">
        <SectionHeader
          eyebrow={aboutPage.principlesEyebrow}
          title={aboutPage.principlesHeading}
          id="principles-heading"
        />
        <ol class="principles" role="list">
          {
            aboutPage.principles.map((p, i) => (
              <li class="principle reveal" style={`--reveal-delay:${i * 60}ms`}>
                <span class="principle-n" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="principle-title">{p.title}</h3>
                  <p class="principle-body">{p.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </section>

  <section class="about-body bg-paper" aria-labelledby="about-work-heading">
    <Container>
      <div class="about-body-inner measure-wide">
        <div class="about-work">
          <h2 id="about-work-heading" class="about-glance-heading">{aboutPage.workHeading}</h2>
          <ul class="about-work-grid" role="list">
            {
              builds.map((b) => (
                <li>
                  <a href={localePath(locale, `/work/${b.slug}`)} class="about-work-card">
                    {b.img && (
                      <Image src={b.img} alt="" widths={[320, 560]} sizes="(min-width: 768px) 260px, 92vw" loading="lazy" />
                    )}
                    <span class="about-work-name">{b.name}</span>
                    <span class="about-work-cat">{b.category}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="about-glance">
          <h2 class="about-glance-heading">{aboutPage.glanceHeading}</h2>
          <ul class="about-glance-list" role="list">
            {aboutPage.glance.map((g) => <li>{g}</li>)}
          </ul>
        </div>

        <div class="about-links">
          {
            links.map((l) => (
              <a href={l.href} class="about-link" target="_blank" rel="noopener">
                {l.label}
                <span class="arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path
                      d="M4 12L12 4M6 4h6v6"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <Partners variant="bone" />

  <CTABand secondary={site.assessmentCta} heading={aboutPage.ctaHeading} />
</Base>

<style>
  .about-hero {
    padding-top: clamp(5rem, 10vw, 8rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .about-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-hero-grid {
      grid-template-columns: 1fr minmax(0, 20rem);
    }
  }
  .about-hero-title {
    margin-top: 1.5rem;
    max-width: 22ch;
  }
  .about-hero-line {
    display: block;
    text-wrap: balance;
  }

  .about-hero-lead {
    margin-top: 1.5rem;
    max-width: 34rem;
  }

  .about-story {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .about-story-prose {
    max-width: 44rem;
  }

  /* ---------- How I think ---------- */
  .about-principles {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }
  @media (min-width: 960px) {
    .principles-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .principle {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 0 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .principle-n {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.9;
    color: var(--color-steel);
    font-variant-numeric: tabular-nums;
  }
  .principle-title {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .principle-body {
    margin-top: 0.4rem;
    max-width: 38rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .about-body {
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  /* Same left edge as the hero and the principles band */
  .about-body-inner {
    margin-inline: 0;
  }

  .about-work {
    margin-top: 0;
  }
  .about-work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .about-work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .about-work-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.6rem 0.6rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease-out-soft),
      transform 0.3s var(--ease-out-soft);
  }
  .about-work-card:hover {
    border-color: color-mix(in srgb, var(--color-steel) 50%, var(--color-line));
    transform: translateY(-3px);
  }
  .about-work-card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border-radius: 9px;
    border: 1px solid var(--color-line);
  }
  .about-work-name {
    margin: 0.85rem 0.35rem 0;
    font-weight: 600;
    color: var(--color-ink);
  }
  .about-work-cat {
    margin: 0.15rem 0.35rem 0;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .about-glance {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .about-glance-heading {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    padding-top: 1rem;
    border-top: 2px solid var(--color-steel);
    display: inline-block;
    margin-bottom: 1.25rem;
  }
  .about-glance-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .about-glance-list li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .about-glance-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 1rem;
    height: 2px;
    background-color: var(--color-steel);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-steel);
    font-weight: 500;
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .about-link:hover {
    color: var(--color-steel-deep);
  }
</style>
